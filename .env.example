# Database Configuration (REQUIRED)
# PostgreSQL connection string format: postgresql://username:password@host:port/dbname
DATABASE_URL=postgresql://postgres:password@localhost:5432/fusion_evaluator

# Google OAuth Configuration (REQUIRED)
# Get from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# JWT Configuration (REQUIRED)
# JWT_SECRET: Cryptographically secure random string, minimum 32 characters
# Use: openssl rand -base64 32
JWT_SECRET=your-secure-jwt-secret-minimum-32-characters-long

# Server Configuration
PORT=5001
NODE_ENV=development
APP_TIMEZONE=Asia/Kolkata
JWT_EXPIRES_IN=12h

# CORS Configuration
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5001

# Optional: Vite API Proxy Target
# Defaults to http://localhost:5001
VITE_API_PROXY_TARGET=http://localhost:5001

# Optional: Database Debug Logging
# Uncomment to enable Prisma query logging
# DATABASE_LOG=query
