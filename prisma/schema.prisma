generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Module {
  id                  String          @id @default(uuid())
  name                String
  date                String          @default("")
  assigned_leads      String[]        @default([])
  has_backend         Boolean         @default(true)
  has_frontend        Boolean         @default(true)
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt
  access_end          DateTime?
  access_start        DateTime?
  spec_rules          Json            @default("[]")
  spec_use_cases      Json            @default("[]")
  spec_workflows      Json            @default("[]")
  spec_layout         Json            @default("{}")
  team_spec_use_cases Json            @default("[]")
  team_spec_workflows Json            @default("[]")
  team_spec_rules     Json            @default("[]")
  team_spec_layout    Json            @default("{}")
  assigned_teams      String[]        @default([])
  team_access_start   DateTime?
  team_access_end     DateTime?
  is_archived         Boolean         @default(false)
  notes               String          @default("")
  activity_logs       activity_logs[]
  divisions           GroupDivision[]
  groups              Group[]

  @@map("modules")
}

model GroupDivision {
  id         String   @id @default(uuid())
  module_id  String
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  module     Module   @relation(fields: [module_id], references: [id], onDelete: Cascade)
  pairs      Group[]

  @@unique([module_id, name])
  @@map("group_divisions")
}

model Group {
  id              String         @id @default(uuid())
  module_id       String
  pair_id         String
  roll_numbers    String[]       @default([])
  domain_leads    String[]       @default([])
  category        String         @default("CONV")
  is_merged       Boolean        @default(false)
  partner_pair_id String?
  evaluation      Json           @default("{}")
  created_at      DateTime       @default(now())
  division_id     String?
  is_submitted    Boolean        @default(false)
  division        GroupDivision? @relation(fields: [division_id], references: [id])
  module          Module         @relation(fields: [module_id], references: [id], onDelete: Cascade)

  @@index([module_id])
  @@map("groups")
}

model User {
  id             Int       @id @default(autoincrement())
  email          String    @unique
  role           String    @default("lead")
  name           String    @default("")
  picture        String    @default("")
  google_subject String    @default("")
  last_login_at  DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  @@map("users")
}

model Admin {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  added_by   String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("admins")
}

model activity_logs {
  id          String   @id
  module_id   String
  actor_email String
  actor_role  String
  action      String
  detail      String   @default("")
  created_at  DateTime @default(now())
  modules     Module   @relation(fields: [module_id], references: [id], onDelete: Cascade)

  @@index([module_id])
}
