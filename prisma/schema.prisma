generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Module {
  id              String          @id @default(uuid())
  name            String
  date            String          @default("")
  assigned_leads  String[]        @default([])
  access_start    DateTime?
  access_end      DateTime?
  has_backend     Boolean         @default(true)
  has_frontend    Boolean         @default(true)
  spec_use_cases  Json            @default("[]")
  spec_workflows  Json            @default("[]")
  spec_rules      Json            @default("[]")
  spec_layout     Json            @default("{}")
  groups          Group[]
  divisions       GroupDivision[]
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt

  @@map("modules")
}

model GroupDivision {
  id         String   @id @default(uuid())
  module_id  String
  module     Module   @relation(fields: [module_id], references: [id], onDelete: Cascade)
  name       String
  pairs      Group[]
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([module_id, name])
  @@map("group_divisions")
}

model Group {
  id              String         @id @default(uuid())
  module_id       String
  module          Module         @relation(fields: [module_id], references: [id], onDelete: Cascade)
  division_id     String?
  division        GroupDivision? @relation(fields: [division_id], references: [id], onDelete: SetNull)
  pair_id         String
  roll_numbers    String[]       @default([])
  category        String         @default("CONV")
  is_merged       Boolean        @default(false)
  partner_pair_id String?
  evaluation      Json           @default("{}")
  created_at      DateTime       @default(now())

  @@map("groups")
}

model User {
  id             Int      @id @default(autoincrement())
  email          String   @unique
  role           String   @default("lead")
  name           String   @default("")
  picture        String   @default("")
  google_subject String   @default("")
  last_login_at  DateTime?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@map("users")
}

model Admin {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  added_by   String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("admins")
}
